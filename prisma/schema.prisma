  completed_at      DateTime? @db.Timestamptz(6)
  admin_notes       String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@map("branch_bundle_requests")
}

model BranchCashExpense {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String    @db.Uuid
  branch_name       String?
  manager_id        String    @db.Uuid
  manager_name      String?
  expense_date      DateTime  @default(now()) @db.Date
  category          String    @default("general")
  description       String
  amount            Decimal   @db.Decimal(15, 2)
  paid_amount       Decimal?  @default(0) @db.Decimal(15, 2)
  due_amount        Decimal?  @default(0) @db.Decimal(15, 2)
  ledger_head_id    String?   @db.Uuid
  receipt_url       String?
  recipient_account String?
  notes             String?
  rent_month        String?
  rent_year         Int?
  billing_month     String?
  billing_year      Int?
  // Cutover-only link columns (Batch-2 migration, not in backup rows).
  salary_payment_id String?   @db.Uuid
  expense_request_id String?  @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@map("branch_cash_expenses")
}

model BranchCashLedger {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id             String    @db.Uuid
  ledger_date           DateTime  @db.Date
  opening_cash          Decimal   @default(0) @db.Decimal(15, 2)
  cash_sales            Decimal   @default(0) @db.Decimal(15, 2)
  bkash_sales           Decimal   @default(0) @db.Decimal(15, 2)
  nagad_sales           Decimal   @default(0) @db.Decimal(15, 2)
  rocket_sales          Decimal   @default(0) @db.Decimal(15, 2)
  card_sales            Decimal   @default(0) @db.Decimal(15, 2)
  bank_transfer_sales   Decimal   @default(0) @db.Decimal(15, 2)
  other_cash_in         Decimal   @default(0) @db.Decimal(15, 2)
  cash_expenses         Decimal   @default(0) @db.Decimal(15, 2)
  bank_deposits_out     Decimal   @default(0) @db.Decimal(15, 2)
  khuchra_amount        Decimal?  @default(0) @db.Decimal(15, 2)
  // In Postgres this is a GENERATED ALWAYS column; Prisma cannot express
  // that — the loader must not write it, or it must be dropped/recreated
  // as a plain column at clone-build time. See notes.
  expected_closing_cash Decimal?  @db.Decimal(15, 2)
  actual_cash           Decimal?  @db.Decimal(15, 2)
  cash_difference       Decimal?  @db.Decimal(15, 2)
  difference_status     String?
  difference_notes      String?
  is_closed             Boolean   @default(false)
  closed_by             String?   @db.Uuid
  closed_at             DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([branch_id, ledger_date])
  @@map("branch_cash_ledger")
}

model BranchFinancialReport {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id       String   @db.Uuid
  report_month    String
  amount          Decimal  @default(0) @db.Decimal(15, 2)
  notes           String?
  created_by      String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([branch_id, report_month])
  @@map("branch_financial_reports")
}

model BranchManagerAssignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String   @db.Uuid
  branch_id   String   @db.Uuid
  assigned_by String?  @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  is_active   Boolean  @default(true)
  notes       String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([employee_id, branch_id])
  @@map("branch_manager_assignments")
}

model BranchPerformanceReport {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id       String?  @db.Uuid
  branch_name     String
  report_month    DateTime @db.Date
  total_sales     Decimal  @default(0) @db.Decimal(15, 2)
  total_profit    Decimal  @default(0) @db.Decimal(15, 2)
  total_loss      Decimal  @default(0) @db.Decimal(15, 2)
  notes           String?
  created_by      String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  // B38: the batch-2 fix adds this unique (with load-time dedupe of
  // the 147 live rows to one per branch+month) so the monthly-report
  // sync is a true upsert and can never duplicate again.
  @@unique([branch_id, report_month])
  @@map("branch_performance_reports")
}

model BranchTransaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id  String   @db.Uuid
  user_id    String?  @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("BDT")
  account    String
  trx_id     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("branch_transactions")
}

model BranchTransfer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  old_branch_id   String?  @db.Uuid
  old_branch_name String?
  new_branch_id   String   @db.Uuid
  new_branch_name String
  join_date       DateTime @db.Date
  note            String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("branch_transfers")
}

model CompanyExpense {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose         String
  // DDL also defines `amount`; backup rows expose total/paid/due only.
  // Kept optional — see notes (conflict C-01).
  amount          Decimal? @default(0) @db.Decimal(15, 2)
  total_amount    Decimal  @default(0) @db.Decimal(15, 2)
  paid_amount     Decimal  @default(0) @db.Decimal(15, 2)
  due_amount      Decimal  @default(0) @db.Decimal(15, 2)
  branch_id       String?  @db.Uuid
  branch_name     String?
  is_all_branches Boolean? @default(false)
  // Settled expense-model spec: 'setup' | 'operating' (migration
  // 20261031_expense_model.sql, cutover-only in the source repo).
  expense_kind    String   @default("operating")
  description     String?
  created_by      String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("company_expenses")
}

model DeveloperPaymentMethod {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  method_type String
  details     Json
  is_active   Boolean? @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("developer_payment_methods")
}

model EmployeeExpenseRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id         String    @db.Uuid
  employee_name       String?
  branch_id           String?   @db.Uuid
  branch_name         String?
  title               String
  description         String?
  amount              Decimal   @db.Decimal(15, 2)
  currency            String    @default("BDT")
  is_purchased        Boolean   @default(false)
  invoice_url         String?
  payment_method      String    @default("bkash")
  account_holder_name String?
  account_number      String?
  bank_name           String?
  bank_branch         String?
  // Part B (copy-buttons round): bank routing for the pay moment —
  // nullable, existing rows read as "—".
  routing_number      String?
  status              String    @default("pending")
  admin_notes         String?
  trx_id              String?
  paid_amount         Decimal?  @default(0) @db.Decimal(15, 2)
  due_amount          Decimal?  @default(0) @db.Decimal(15, 2)
  paid_at             DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@map("employee_expense_requests")
}

// REMODELLED 2026-10-31 to the Layer-2 dump's real shape (Agent B drift
// report, dump_schema_public.sql): a lookup table, the twin of
// `positions` — {id uuid PK DEFAULT gen_random_uuid(), name text NOT NULL
// UNIQUE (employee_positions_name_key), created_at timestamptz NOT NULL
// DEFAULT now()}. The earlier provisional junction shape
// (employee_id/profile_id/position_id/branch_id/is_active/updated_at)
// does not exist in the source DB, and the real `name` column had no
// counterpart in it. Source table holds 0 rows, and grep over app/ +
// lib/ + components/ (2026-10-31) finds zero code references to
// EmployeePosition / employee_positions, so the remodel breaks nothing.
model EmployeePosition {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("employee_positions")
}

model EmployeeSalaryAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id    String   @db.Uuid
  bank_name      String
  account_name   String
  account_number String
  routing_number String?
  is_active      Boolean? @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("employee_salary_accounts")
}

model HouseRentAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id      String   @db.Uuid
  bank_name      String
  account_name   String
  account_number String
  routing_number String?
  // Part B (copy-buttons round): landlord payment details that had
  // nowhere to live — all nullable, existing rows read as "—".
  bank_branch             String?
  mobile_banking_provider String?
  mobile_banking_number   String?
  rent_amount    Decimal? @default(0) @db.Decimal(15, 2)
  is_active      Boolean? @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("house_rent_accounts")
}

model InvoiceRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by  String   @db.Uuid
  title       String
  description String?
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("BDT")
  status      String   @default("pending")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("invoice_requests")
}

model LedgerHead {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code_number             Int       @unique
  name                    String
  ledger_type             String    @default("All")
  is_active               Boolean   @default(true)
  // Backup exposes a timestamptz value here; DDL says DATE. Backup wins
  // (conflict C-02 in notes) — modelled as timestamptz.
  reference_creation_date DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)

  @@map("ledger_heads")
}

model Notification {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid
  title         String
  message       String
  // Backup column is `read`; scratch DDL uses `is_read` + action_url.
  // Backup wins for `read`; is_read/action_url kept optional (C-03).
  read          Boolean  @default(false)
  is_read       Boolean?
  action_url    String?
  type          String   @default("general")
  is_admin_only Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("notifications")
}

model OvertimeLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String?  @db.Uuid
  profile_id        String?  @db.Uuid
  salary_payment_id String?  @db.Uuid
  amount            Decimal  @db.Decimal(15, 2)
  reason            String?
  log_date          DateTime @db.Date
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("overtime_logs")
}

model PasswordResetRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  // Plain String by design — no restrictive enum (the fix widened the CHECK).
  status         String    @default("pending")
  otp_code       String?
  otp_expires_at DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@map("password_reset_requests")
}

model PaymentRequest {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String    @db.Uuid
  invoice_title          String
  invoice_number         String
  description            String?
  amount                 Decimal   @db.Decimal(15, 2)
  currency               String    @default("BDT")
  invoice_file_url       String
  // Postgres enum payout_method in DDL — modelled as String (see notes).
  payment_method         String
  payment_details        Json?     @default("{}")
  // Postgres enum payment_status in DDL — modelled as String.
  status                 String    @default("pending")
  transaction_id         String?
  payment_screenshot_url String?
  admin_notes            String?
  rejection_reason       String?
  account_name           String?
  mobile_number          String?
  bank_name              String?
  account_number         String?
  routing_number         String?
  branch_name            String?
  swift_code             String?
  completed_at           DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  @@map("payment_requests")
}

model Position {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("positions")
}

model PositionTransfer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid
  old_position_id   String?  @db.Uuid
  old_position_name String?
  new_position_id   String   @db.Uuid
  new_position_name String
  join_date         DateTime @db.Date
  note              String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("position_transfers")
}

model ProductChalan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id       String?  @db.Uuid
  branch_name     String
  chalan_ref      String?
  // Backup rows carry items as a JSON array; DDL declares JSONB. Json wins.
  items           Json     @default("[]")
  total_amount    Decimal  @default(0) @db.Decimal(15, 2)
  total_cost      Decimal  @default(0) @db.Decimal(15, 2)
  notes           String?
  created_by      String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("product_chalans")
}

// Profile.id is the AuthUser.id (same UUID, from the legacy auth store).
// Relation Profile -> AuthUser on id is intentionally NOT declared as a
// Prisma @relation: adding it would force a DB foreign key on
// profiles.id. The link is by identical UUID, enforced at load time.
model Profile {
  id                            String    @id @db.Uuid
  full_name                     String
  email                         String?
  employee_id                   String?
  phone_number                  String?
  country                       String?
  address                       String?
  whatsapp_number               String?
  branch                        String?
  branch_id                     String?   @db.Uuid
  position                      String?
  position_id                   String?   @db.Uuid
  role                          String    @default("employee")
  profile_type                  String    @default("partner")
  verification_status           String    @default("pending")
  rejection_reason              String?
  profile_photo_url             String?
  account                       Json?
  bank_info                     Json?
  salary                        Decimal?  @db.Decimal(15, 2)
  security_question             String?
  security_answer               String?
  is_2fa_enabled                Boolean   @default(false)
  is_banned                     Boolean   @default(false)
  is_branch_manager             Boolean   @default(false)
