// ============================================================================
// anchorerp clone — Prisma schema
// Provenance: generated 2026-10-31 from Layer-1 backup real columns
//   (~/workspace/aso_diag/anchorerp_backup/2026-10-31/, PostgREST-exposed rows,
//   count- and hash-verified) cross-checked against repo DDL in
//   the legacy migration SQL that shipped with the old codebase,
//   cross-checked file by file. Where DDL and backup columns disagreed, the
//   BACKUP's real columns won; conflicts are logged in
//   ~/workspace/aso_diag/clone_schema_notes.md.
//   Final reconciliation against the Layer-2 full dump (pg_dump) is
//   owner-gated and has NOT happened yet — do not treat this schema as
//   final until that reconciliation is done.
// Views — NOT models, rebuilt in code:
//   branch_accounts_summary, employee_verifications,
//   partner_verifications, profiles_admin_view
//   (employee_verifications / partner_verifications are views over
//   verification_requests filtered by profile_type; profiles_admin_view is
//   a view over profiles; branch_accounts_summary is an aggregate view
//   over branches / branch_cash_ledger / branch_bank_deposits.)
// Provisional models (shape not verified against live rows):
//   EmployeePosition (code/DDL evidence only — see model comment),
//   plus every 0-row table whose shape comes from DDL only, and the
//   DDL-only non-exposed attendance set. Full list in the notes file.
// Conventions: model names PascalCase singular; field names are exactly
//   the DB column names (snake_case); @@map on every model; no @relation
//   FKs are declared (relations are application-level in the source app;
//   see the Profile/AuthUser note on the Profile model).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (blueprint §3) — populated at load time from the dump's auth.users
// with identical UUIDs; bcrypt hashes carried in legacyBcryptHash.
// ---------------------------------------------------------------------------

model AuthUser {
  id                 String    @id @db.Uuid
  email              String    @unique
  password_hash      String?
  legacy_bcrypt_hash String?
  email_confirmed_at DateTime? @db.Timestamptz(6)
  last_sign_in_at    DateTime? @db.Timestamptz(6)
  raw_user_meta_data Json?
  raw_app_meta_data  Json?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  @@map("auth_users")
}

// Data-carry only — approximated from the legacy auth identity shape.
model AuthIdentity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  provider      String
  provider_id   String?
  identity_data Json?
  created_at    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("auth_identities")
}

// ---------------------------------------------------------------------------
// A. PostgREST-exposed tables (backup-verified where rows exist)
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  details     Json?
  ip_address  String?
  device_info String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("activity_logs")
}

model AdminUser {
  id String @id @db.Uuid

  @@map("admin_users")
}

model BonusLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String?  @db.Uuid
  profile_id        String?  @db.Uuid
  salary_payment_id String?  @db.Uuid
  amount            Decimal  @db.Decimal(15, 2)
  reason            String?
  log_date          DateTime @db.Date
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("bonus_logs")
}

model Branch {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  // DDL-only columns below (attendance/scratch DDL; NOT in backup rows,
  // which expose only id, name, created_at) — kept optional for load safety.
  address                String?
  latitude               Float?
  longitude              Float?
  geofence_radius_meters Int?
  radius_meters          Int?
  is_active              Boolean?
  created_by             String?   @db.Uuid
  code                   String?   @unique
  city                   String?
  phone                  String?
  manager_id             String?   @db.Uuid
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime? @db.Timestamptz(6)

  @@map("branches")
}

model BranchAuditTrail {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String?  @db.Uuid
  branch_name       String?
  table_name        String
  record_id         String   @db.Uuid
  action            String
  performed_by      String?  @db.Uuid
  performed_by_name String?
  old_value         Json?
  new_value         Json?
  notes             String?
  ip_address        String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("branch_audit_trail")
}

model BranchBankDeposit {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id           String    @db.Uuid
  branch_name         String?
  manager_id          String    @db.Uuid
  manager_name        String?
  deposit_date        DateTime  @db.Date
  sales_from_date     DateTime? @db.Date
  sales_to_date       DateTime? @db.Date
  amount              Decimal   @db.Decimal(15, 2)
  bank_account_name   String
  bank_account_number String?
  deposit_slip_number String?
  bank_transaction_id String?
  deposited_by_name   String?
  slip_attachment_url String?
  bank_statement_url  String?
  notes               String?
  daily_breakdown     Json?
  khuchra_amount      Decimal?  @default(0) @db.Decimal(15, 2)
  status              String    @default("draft")
  submitted_at        DateTime? @db.Timestamptz(6)
  reviewed_by         String?   @db.Uuid
  reviewed_by_name    String?
  reviewed_at         DateTime? @db.Timestamptz(6)
  rejection_reason    String?
  is_reversed         Boolean   @default(false)
  reversal_note       String?
  reversed_by         String?   @db.Uuid
  reversed_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@map("branch_bank_deposits")
}

model BranchBundleRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String    @db.Uuid
  branch_name       String?
  manager_id        String    @db.Uuid
  manager_name      String?
  bundle_10_count   Int       @default(0)
  bundle_20_count   Int       @default(0)
  bundle_50_count   Int       @default(0)
  bundle_100_count  Int       @default(0)
  total_amount      Decimal   @db.Decimal(15, 2)
  urgency           String    @default("normal")
  reason            String?
  status            String    @default("requested")
  task_id           String?   @db.Uuid
  processed_by      String?   @db.Uuid
  processed_by_name String?
