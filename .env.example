# Anchor ERP — environment (Prisma + Postgres).
# Only the variables below are used. All secrets are
# server-only; never commit real values.

# Postgres connection (Neon in production; local Postgres in dev).
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Session cookie signing secret (login sessions + registration
# proof tokens). Long random string. REQUIRED — the app refuses
# session operations without it.
SESSION_SECRET=

# Optional dedicated secrets (fall back to SESSION_SECRET when unset).
OTP_HASH_SECRET=
TWO_FACTOR_COOKIE_SECRET=

# Email (Resend). The API key lives ONLY here — it is never stored
# in the database or returned by any API (clone rule, audit A7).
RESEND_API_KEY=

# Public app URL used in email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage root for the local driver (uploads). Production
# wiring (e.g. Vercel Blob) replaces the driver behind
# lib/server/storage.ts.
STORAGE_ROOT=
